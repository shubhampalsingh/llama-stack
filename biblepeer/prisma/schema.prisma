generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Auth.js (NextAuth v5) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  accounts    Account[]
  sessions    Session[]
  apiKey      ApiKey?
  memberships CircleMember[]
  studies     Study[]
  reflections Reflection[]
  progress    ReadingProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// User's Anthropic API key (for the AI study helper), AES-256-GCM encrypted.
model ApiKey {
  id         String   @id @default(cuid())
  userId     String   @unique
  ciphertext String
  keyHint    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- BiblePeer ----------

model Circle {
  id          String  @id @default(cuid())
  name        String
  description String  @default("")
  emoji       String  @default("🕊️")
  isPublic    Boolean @default(false)
  inviteCode  String  @unique

  members CircleMember[]
  studies Study[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublic, updatedAt])
}

enum CircleRole {
  OWNER
  MEMBER
}

model CircleMember {
  id       String     @id @default(cuid())
  circleId String
  userId   String
  role     CircleRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([userId])
}

// One passage study inside a circle, with its scripture text cached at creation.
model Study {
  id          String @id @default(cuid())
  circleId    String
  createdById String
  title       String
  reference   String // e.g. "John 3:1-21"
  translation String @default("WEB")
  passageText String @db.Text // cached from the Bible API

  reflections Reflection[]

  createdAt DateTime @default(now())

  circle    Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([circleId, createdAt])
}

model Reflection {
  id      String @id @default(cuid())
  studyId String
  userId  String
  content String @db.Text

  createdAt DateTime @default(now())

  study Study @relation(fields: [studyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([studyId, createdAt])
}

// ---------- Mobile app auth (bearer tokens for the iOS app) ----------

// Short-lived 6-digit sign-in codes emailed to the user.
model MobileAuthCode {
  id       String   @id @default(cuid())
  email    String
  codeHash String
  expires  DateTime
  attempts Int      @default(0)

  createdAt DateTime @default(now())

  @@index([email])
}

// Long-lived bearer tokens held by the mobile app (hash stored, never the token).
model MobileToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Progress on a static reading plan (plans defined in src/data/plans.ts).
model ReadingProgress {
  id          String   @id @default(cuid())
  userId      String
  planId      String // key from plans.ts
  day         Int
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planId, day])
  @@index([userId, planId])
}
