generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Auth.js (NextAuth v5) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
  apiKey   ApiKey?
  agents   Agent[]
  missions Mission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- AI Commander ----------

// User's Anthropic API key, encrypted at rest with AES-256-GCM.
model ApiKey {
  id         String   @id @default(cuid())
  userId     String   @unique
  ciphertext String // base64: iv + authTag + encrypted key
  keyHint    String // last 4 chars for display, e.g. "...x7Qa"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Agent {
  id           String  @id @default(cuid())
  userId       String
  name         String
  emoji        String  @default("🤖")
  description  String  @default("")
  systemPrompt String  @db.Text
  model        String  @default("claude-opus-4-8")
  webSearch    Boolean @default(true)
  effort       String  @default("high") // low | medium | high

  tasks MissionTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum MissionStatus {
  DRAFT
  RUNNING
  COMPLETED
  FAILED
}

model Mission {
  id        String        @id @default(cuid())
  userId    String
  title     String
  objective String        @db.Text
  status    MissionStatus @default(DRAFT)

  tasks MissionTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum TaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// One agent's assignment within a mission.
model MissionTask {
  id          String     @id @default(cuid())
  missionId   String
  agentId     String
  instruction String     @db.Text // per-agent brief (defaults to mission objective)
  status      TaskStatus @default(PENDING)
  transcript  Json? // array of events: text, thinking, web_search, error
  result      String?    @db.Text // final text output
  inputTokens Int        @default(0)
  outputTokens Int       @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([missionId])
}
