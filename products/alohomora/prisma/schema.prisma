generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  image            String?
  memberSince      DateTime? // set on approval — null means not (yet) a member
  isFoundingMember Boolean   @default(false)
  createdAt        DateTime  @default(now())

  accounts    Account[]
  sessions    Session[]
  application Application?
  profile     MemberProfile?
  unlocks     Unlock[]
  offers      Offer[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Application {
  id              String   @id @default(cuid())
  userId          String   @unique
  fullName        String
  company         String
  role            String
  stage           String // idea | pre-revenue | revenue | scaled | exited | investor | executive
  industry        String
  city            String
  linkedin        String
  building        String   @db.Text // what are you building / working on
  doorsCanOpen    String   @db.Text // the key question
  doorsNeedOpened String   @db.Text
  referral        String?
  whyYou          String   @db.Text
  status          String   @default("pending") // pending | approved | rejected | waitlist
  aiSummary       String?  @db.Text // Claude screening notes for the admin
  createdAt       DateTime @default(now())
  decidedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model MemberProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  headline     String // e.g. "Founder & CEO, Acme Logistics"
  company      String
  role         String
  industry     String
  city         String
  linkedin     String
  bio          String   @db.Text
  doorsCanOpen String   @db.Text // expertise & network — powers matching
  lookingFor   String?  @db.Text
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Unlock {
  id            String   @id @default(cuid())
  userId        String
  title         String // "the locked door" in one line
  category      String // fundraising | hiring | sales | partnerships | regulatory | ops | tech | other
  details       String   @db.Text
  status        String   @default("open") // open | unlocked | closed
  aiSuggestions Json? // [{userId, name, headline, reason}]
  createdAt     DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers Offer[]

  @@index([status, createdAt])
}

model Offer {
  id        String   @id @default(cuid())
  unlockId  String
  userId    String
  message   String   @db.Text // "I can open this door — here's how"
  createdAt DateTime @default(now())

  unlock Unlock @relation(fields: [unlockId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([unlockId, userId])
}
