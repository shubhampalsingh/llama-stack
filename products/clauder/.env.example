# --- Claude API (required for the Prompt Doctor) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (default: claude-opus-4-8)
# ANTHROPIC_MODEL=claude-haiku-4-5

# --- Database (required for submissions + newsletter) ---
# Free Postgres from https://neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Auth (required) ---
# Generate with: npx auth secret
AUTH_SECRET=changeme

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect URIs: https://clauder.club/api/auth/callback/google
#                http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=xxxxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-...

# --- Admin (comma-separated emails that can approve submissions) ---
ADMIN_EMAILS=shubhampalsingh49@gmail.com
