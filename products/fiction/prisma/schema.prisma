generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  stories  Story[]
  usage    UsageDay[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// A story: an interactive adventure ("play") or a manuscript ("write").
model Story {
  id        String   @id @default(cuid())
  userId    String
  mode      String // "play" | "write"
  title     String
  tagline   String?
  emoji     String? // cover emoji art, e.g. "🐉🏰✨"
  genre     String?
  premise   String?  @db.Text
  status    String   @default("active") // "active" | "ended"
  draft     String?  @db.Text // write mode: the manuscript
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scenes Scene[]
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

// Play mode: one scene per turn.
model Scene {
  id        String   @id @default(cuid())
  storyId   String
  index     Int
  text      String   @db.Text
  chosen    String? // the choice the player took AFTER this scene
  choices   Json? // the 3 choices offered with this scene
  isEnding  Boolean  @default(false)
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, index])
}

model UsageDay {
  id     String @id @default(cuid())
  userId String
  date   String // YYYY-MM-DD (UTC)
  turns  Int    @default(0) // play scenes + write assists share one counter

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}
