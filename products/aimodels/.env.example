# Copy to .env and fill in. Never commit .env.

# Postgres (Neon) — only used for the newsletter list
DATABASE_URL="postgresql://user:password@host/aimodels?sslmode=require"

# Anthropic API key — powers the Model Matchmaker
ANTHROPIC_API_KEY=""
# Optional model override (default: claude-opus-4-8)
# ANTHROPIC_MODEL="claude-haiku-4-5"

# Secret for signing the guest rate-limit cookie
APP_SECRET="generate-with: openssl rand -base64 32"
