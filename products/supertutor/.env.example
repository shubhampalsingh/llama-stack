# --- Claude API (required) ---
# Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the tutor model (default: claude-opus-4-8)
# ANTHROPIC_MODEL=claude-haiku-4-5

# --- Database (required) ---
# Free Postgres from https://neon.tech (or Vercel Postgres / Supabase)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Auth (required) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=changeme

# Google OAuth credentials — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://supertutor.fun/api/auth/callback/google
# (and http://localhost:3000/api/auth/callback/google for local dev)
AUTH_GOOGLE_ID=xxxxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-...
