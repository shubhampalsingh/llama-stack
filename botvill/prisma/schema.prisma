generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Auth.js (NextAuth v5) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
  apiKey   ApiKey?
  bots     Bot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Bot owner's Anthropic API key (powers all visitor chats), AES-256-GCM encrypted.
model ApiKey {
  id         String   @id @default(cuid())
  userId     String   @unique
  ciphertext String
  keyHint    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- BotVill ----------

model Bot {
  id        String @id @default(cuid())
  publicKey String @unique // used in embeds and hosted pages — safe to expose
  userId    String

  name      String
  emoji     String @default("🤖")
  color     String @default("#5a67d8") // widget accent
  greeting  String @default("Hi! How can I help you today?")
  persona   String @default("") @db.Text // system-prompt personality/instructions
  knowledge String @default("") @db.Text // pasted knowledge base (≤100k chars)
  model     String @default("claude-haiku-4-5")

  enabled           Boolean @default(true)
  dailyMessageCap   Int     @default(200) // across all visitors, per UTC day
  visitorMessageCap Int     @default(20) // per visitor, per UTC day

  totalMessages Int @default(0)

  usage        BotUsage[]
  visitorUsage VisitorUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Per-bot, per-UTC-day message counter (the global cap).
model BotUsage {
  id    String @id @default(cuid())
  botId String
  day   String // "2026-07-07"
  count Int    @default(0)

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, day])
}

// Per-visitor, per-UTC-day message counter (the visitor cap).
model VisitorUsage {
  id        String @id @default(cuid())
  botId     String
  visitorId String // anonymous id generated by the widget
  day       String
  count     Int    @default(0)

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, visitorId, day])
}
